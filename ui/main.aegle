Window {
    title: "FXLauncher — Minecraft Launcher"
    width: 720dp
    height: 560dp
    padding: 20dp
    gap: 12dp

    Row {
        gap: 12dp
        align: center
        Text { text: "FXLauncher"; font_size: 20dp; grow: 1 }
        Button { id: theme_toggle; text: "切换主题" }
    }

    Separator {}

    // Account row
    Row {
        gap: 12dp
        align: center
        Text { text: "玩家名称:"; width: 80dp }
        TextField {
            id: player_name
            text: "Steve"
            grow: 1
        }
        CheckBox {
            id: offline_mode
            text: "离线模式"
            checked: true
        }
    }

    // Version selection row
    Row {
        gap: 12dp
        align: center
        Text { text: "游戏版本:"; width: 80dp }
        TextField {
            id: version_input
            text: "1.21.4"
            grow: 1
        }
        Button { id: refresh_versions; text: "扫描版本" }
    }

    // Java path row
    Row {
        gap: 12dp
        align: center
        Text { text: "Java 路径:"; width: 80dp }
        TextField {
            id: java_input
            text: "java"
            grow: 1
        }
        Button { id: detect_java; text: "自动检测" }
    }

    // Memory row
    Row {
        gap: 12dp
        align: center
        Text { text: "最大内存:"; width: 80dp }
        Slider {
            id: memory_slider
            min: 1024
            max: 16384
            value: 4096
            step: 512
            grow: 1
        }
        Text { id: memory_display; text: "4096 MB"; width: 80dp }
    }

    // Game directory row
    Row {
        gap: 12dp
        align: center
        Text { text: "游戏目录:"; width: 80dp }
        TextField {
            id: game_dir_input
            text: ""
            grow: 1
        }
    }

    Separator {}

    // Actions row
    Row {
        gap: 12dp
        align: center
        Text { id: status_label; text: "就绪"; grow: 1 }
        Button { id: save_btn; text: "保存配置" }
        Button { id: launch_btn; text: "启动游戏" }
    }

    // Log area
    TextArea {
        id: log_view
        text: "[FXLauncher] 初始化完成，准备就绪。"
        read_only: true
        grow: 1
    }
}
